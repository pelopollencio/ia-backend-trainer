{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkoutRequestSchema",
  "type": "object",
  "properties": {
    "deporte": { "type": "string" },
    "duracion": { "type": "integer", "minimum": 1 },
    "tipo de entrenamiento": { "type": "string" },
    "ultimos entrenamientos": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EntrenamientoSchema"
      }
    },
    "preferencias": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "deporte",
    "duracion",
    "tipo de entrenamiento"
  ],
  "additionalProperties": false,
  "definitions": {
    "EntrenamientoSchema": {
      "type": "object",
      "properties": {
        "deporte": { "type": "string" },
        "duracion": { "type": "integer", "minimum": 1 },
        "tipo de entrenamiento": { "type": "string" },
        "calentamiento": { "type": "string" },
        "bloques de entrenamiento": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bloque": { "type": "integer", "minimum": 1 },
              "tiempo": { "type": "number", "minimum": 0 },
              "ritmo": { "type": "string" },
              "descanso": { "type": "number", "minimum": 0 }
            },
            "required": ["bloque", "tiempo", "ritmo", "descanso"],
            "additionalProperties": false
          }
        },
        "enfriamiento": { "type": "string" }
      },
      "required": [
        "deporte",
        "duracion",
        "tipo de entrenamiento",
        "calentamiento",
        "bloques de entrenamiento",
        "enfriamiento"
      ],
      "additionalProperties": false
    }
  }
}